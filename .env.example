# Backend settings use the SI_ prefix.
SI_DATABASE_URL=sqlite:///./backend/social_intelligence.db
SI_CORS_ORIGINS=http://localhost:3000

# Optional read-only production sync. Leave empty to use fixtures.
SI_LANA_SSH_HOST=
SI_LANA_POSTGRES_CONTAINER=lana-postgres

NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Grok CLI X collector (public web results only).
SI_GROK_BIN=~/.grok/bin/grok
SI_X_MAX_SYMBOLS=12
SI_X_LOOKBACK_MINUTES=60
SI_X_INTERVAL_SECONDS=900

# Square targeted-search backfill via the official browser UI.
SI_SQUARE_SEARCH_DAYS=7
SI_SQUARE_SEARCH_PAGES=5
SI_SQUARE_SEARCH_WAIT_MS=5000
